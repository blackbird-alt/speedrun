# FE AI (OpenAI) — LOCAL, AUTHOR-ONLY configuration.
#
# Copy this file to `.env` (which is git-ignored) and paste your own key.
# This key is used only on YOUR machine to run the build-time card-generation
# pipeline and the optional in-app AI helpers. It is NEVER committed and NEVER
# shipped in the installer/APK. Other users who want the in-app AI set their own
# key in the app (Desktop: Tools -> Set OpenAI key; Android: Settings ->
# Advanced -> FE AI). The shipped apps run fully with AI switched off.

FE_AI_PROVIDER=openai
FE_AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-your-own-key-here
